# Inua360 Frontend Environment Variables
# Copy this file to .env and fill in your values

# ==================== API CONFIGURATION ====================

# Backend API Base URL
# Development: http://localhost:8000/api/v1
# Production: https://api.inua360.co.ke/v1
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# ==================== SUPABASE (Optional - if using Supabase Auth) ====================

# Supabase Project URL
REACT_APP_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key
REACT_APP_SUPABASE_ANON_KEY=your_anon_key_here

# ==================== FIREBASE CONFIGURATION ====================

# Firebase configuration values
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ==================== FEATURE FLAGS ====================

# Enable n8n webhook integration
REACT_APP_ENABLE_N8N_WEBHOOKS=true

# Enable mock data fallback (useful for development)
REACT_APP_USE_MOCK_DATA=false

# ==================== ANALYTICS (Optional) ====================

# Google Analytics Measurement ID
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
REACT_APP_SENTRY_DSN=https://your_sentry_dsn_here

# ==================== EXTERNAL SERVICES ====================

# M-Pesa Daraja API (Backend handles this, but frontend may need for OAuth redirects)
REACT_APP_MPESA_CONSUMER_KEY=your_consumer_key
REACT_APP_MPESA_REDIRECT_URI=http://localhost:3000/mpesa/callback

# ==================== APP CONFIGURATION ====================

# App version
REACT_APP_VERSION=2.0.0

# Environment name (development, staging, production)
REACT_APP_ENV=development

# API Request Timeout (milliseconds)
REACT_APP_API_TIMEOUT=30000

# ==================== NOTES ====================

# 1. Never commit .env to git (already in .gitignore)
# 2. Backend team needs to provide REACT_APP_API_BASE_URL
# 3. Supabase variables only needed if using Supabase for auth
# 4. Set REACT_APP_USE_MOCK_DATA=false once backend is ready
